{
  "name": "@workspace/agent",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./paypal": {
      "types": "./src/paypal/index.ts",
      "import": "./src/paypal/index.ts",
      "default": "./dist/paypal/index.js"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts",
      "default": "./dist/mcp/index.js"
    }
  },
  "bin": {
    "agentpay-mcp": "./dist/mcp/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules",
    "dev": "tsc --build --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "mcp": "tsx src/mcp/cli.ts",
    "test": "vitest run"
  },
  "prettier": "@workspace/prettier-config",
  "dependencies": {
    "@ai-sdk/google": "catalog:core",
    "@ai-sdk/openai": "catalog:core",
    "@modelcontextprotocol/sdk": "catalog:core",
    "@paypal/paypal-server-sdk": "catalog:core",
    "@workspace/db": "workspace:*",
    "ai": "catalog:core",
    "zod": "catalog:core"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-presets": "workspace:*",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
